<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Light palette (inspired by macOS system colours) -->
    <SolidColorBrush x:Key="Brush.WindowBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.SidebarBg" Color="#F1F1F4"/>
    <SolidColorBrush x:Key="Brush.ContentBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.CardBg" Color="#F6F6F8"/>
    <SolidColorBrush x:Key="Brush.CardBorder" Color="#E6E6EB"/>
    <SolidColorBrush x:Key="Brush.ToolbarBg" Color="#F7F7F9"/>
    <SolidColorBrush x:Key="Brush.CanvasBg" Color="#E8E8EC"/>
    <SolidColorBrush x:Key="Brush.Text" Color="#1D1D1F"/>
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#6E6E73"/>
    <SolidColorBrush x:Key="Brush.TextTertiary" Color="#A1A1A6"/>
    <SolidColorBrush x:Key="Brush.Separator" Color="#E2E2E7"/>
    <SolidColorBrush x:Key="Brush.ControlBg" Color="#EBEBEF"/>
    <SolidColorBrush x:Key="Brush.ControlBgHover" Color="#E1E1E6"/>
    <SolidColorBrush x:Key="Brush.ControlBgPressed" Color="#D6D6DC"/>
    <SolidColorBrush x:Key="Brush.Hover" Color="#0F000000"/>
    <SolidColorBrush x:Key="Brush.Pressed" Color="#1C000000"/>
    <SolidColorBrush x:Key="Brush.Accent" Color="#007AFF"/>
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#0068DB"/>
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="#0058BA"/>
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#1F007AFF"/>
    <SolidColorBrush x:Key="Brush.SelectedItem" Color="#E1E1E6"/>
    <SolidColorBrush x:Key="Brush.Green" Color="#34C759"/>
    <SolidColorBrush x:Key="Brush.ToggleOff" Color="#E1E1E6"/>
    <SolidColorBrush x:Key="Brush.ToggleKnob" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.SegmentBg" Color="#E9E9ED"/>
    <SolidColorBrush x:Key="Brush.SegmentSelected" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.Red" Color="#FF3B30"/>
    <SolidColorBrush x:Key="Brush.TooltipBg" Color="#FBFBFD"/>
    <SolidColorBrush x:Key="Brush.TooltipText" Color="#1D1D1F"/>
    <SolidColorBrush x:Key="Brush.ScrollThumb" Color="#38000000"/>
    <SolidColorBrush x:Key="Brush.InputBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.InputBorder" Color="#D2D2D7"/>
    <SolidColorBrush x:Key="Brush.Thumbnail" Color="#ECECF0"/>
    <SolidColorBrush x:Key="Brush.Banner" Color="#EEF5FF"/>
    <SolidColorBrush x:Key="Brush.BannerBorder" Color="#D2E5FF"/>
    <Color x:Key="Color.Shadow">#000000</Color>
    <system:Double xmlns:system="clr-namespace:System;assembly=System.Runtime" x:Key="Shadow.Opacity">0.12</system:Double>
</ResourceDictionary>
