<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark palette (inspired by macOS dark mode) -->
    <SolidColorBrush x:Key="Brush.WindowBg" Color="#1E1E20"/>
    <SolidColorBrush x:Key="Brush.SidebarBg" Color="#252528"/>
    <SolidColorBrush x:Key="Brush.ContentBg" Color="#1C1C1E"/>
    <SolidColorBrush x:Key="Brush.CardBg" Color="#262628"/>
    <SolidColorBrush x:Key="Brush.CardBorder" Color="#313134"/>
    <SolidColorBrush x:Key="Brush.ToolbarBg" Color="#28282B"/>
    <SolidColorBrush x:Key="Brush.CanvasBg" Color="#161618"/>
    <SolidColorBrush x:Key="Brush.Text" Color="#F5F5F7"/>
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#A1A1A6"/>
    <SolidColorBrush x:Key="Brush.TextTertiary" Color="#6E6E73"/>
    <SolidColorBrush x:Key="Brush.Separator" Color="#343437"/>
    <SolidColorBrush x:Key="Brush.ControlBg" Color="#3A3A3D"/>
    <SolidColorBrush x:Key="Brush.ControlBgHover" Color="#454548"/>
    <SolidColorBrush x:Key="Brush.ControlBgPressed" Color="#505053"/>
    <SolidColorBrush x:Key="Brush.Hover" Color="#17FFFFFF"/>
    <SolidColorBrush x:Key="Brush.Pressed" Color="#26FFFFFF"/>
    <SolidColorBrush x:Key="Brush.Accent" Color="#0A84FF"/>
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#3395FF"/>
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="#0071DC"/>
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#2E0A84FF"/>
    <SolidColorBrush x:Key="Brush.SelectedItem" Color="#38383B"/>
    <SolidColorBrush x:Key="Brush.Green" Color="#30D158"/>
    <SolidColorBrush x:Key="Brush.ToggleOff" Color="#3A3A3E"/>
    <SolidColorBrush x:Key="Brush.ToggleKnob" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.SegmentBg" Color="#1A1A1C"/>
    <SolidColorBrush x:Key="Brush.SegmentSelected" Color="#5A5A5E"/>
    <SolidColorBrush x:Key="Brush.Red" Color="#FF453A"/>
    <SolidColorBrush x:Key="Brush.TooltipBg" Color="#2C2C2E"/>
    <SolidColorBrush x:Key="Brush.TooltipText" Color="#F5F5F7"/>
    <SolidColorBrush x:Key="Brush.ScrollThumb" Color="#45FFFFFF"/>
    <SolidColorBrush x:Key="Brush.InputBg" Color="#1C1C1E"/>
    <SolidColorBrush x:Key="Brush.InputBorder" Color="#48484A"/>
    <SolidColorBrush x:Key="Brush.Thumbnail" Color="#2A2A2D"/>
    <SolidColorBrush x:Key="Brush.Banner" Color="#1A2738"/>
    <SolidColorBrush x:Key="Brush.BannerBorder" Color="#24405F"/>
    <Color x:Key="Color.Shadow">#000000</Color>
    <system:Double xmlns:system="clr-namespace:System;assembly=System.Runtime" x:Key="Shadow.Opacity">0.45</system:Double>
</ResourceDictionary>
