<Window x:Class="LinearFrame.Viewer.ImageViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:LinearFrame.Core"
        xmlns:ui="clr-namespace:LinearFrame.UI"
        xmlns:vw="clr-namespace:LinearFrame.Viewer"
        Title="LinearFrame" Width="960" Height="680" MinWidth="380" MinHeight="260"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.CanvasBg}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="{StaticResource Font.UI}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid TextElement.Foreground="{DynamicResource Brush.Text}">
        <Grid.RowDefinitions>
            <RowDefinition Height="46"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= Toolbar (also the title bar) ================= -->
        <Border Background="{DynamicResource Brush.ToolbarBg}" BorderBrush="{DynamicResource Brush.Separator}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel x:Name="NavButtons" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0"
                            WindowChrome.IsHitTestVisibleInChrome="True" Visibility="Collapsed">
                    <Button x:Name="PrevBtn" Style="{StaticResource Btn.Icon}" ToolTip="{core:Loc Viewer.Prev}" Click="Prev_Click">
                        <ui:IconView Icon="chevron-left"/>
                    </Button>
                    <Button x:Name="NextBtn" Style="{StaticResource Btn.Icon}" ToolTip="{core:Loc Viewer.Next}" Click="Next_Click">
                        <ui:IconView Icon="chevron-right"/>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,10,0">
                    <TextBlock x:Name="TitleText" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    <TextBlock x:Name="InfoText" Style="{StaticResource Text.Caption}" FontSize="12" Margin="10,1,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <StackPanel x:Name="ZoomGroup" Orientation="Horizontal">
                        <Button Style="{StaticResource Btn.Icon}" Width="30" ToolTip="{core:Loc Viewer.ZoomOut}" Click="ZoomOut_Click">
                            <ui:IconView Icon="minus" Width="14" Height="14"/>
                        </Button>
                        <Button Style="{StaticResource Btn.Icon}" Width="54" ToolTip="{core:Loc Viewer.ZoomToggle}" Click="ZoomToggle_Click">
                            <TextBlock x:Name="ZoomText" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}"/>
                        </Button>
                        <Button Style="{StaticResource Btn.Icon}" Width="30" ToolTip="{core:Loc Viewer.ZoomIn}" Click="ZoomIn_Click">
                            <ui:IconView Icon="plus" Width="14" Height="14"/>
                        </Button>
                        <Border Width="1" Margin="8,9" Background="{DynamicResource Brush.Separator}"/>
                    </StackPanel>
                    <Button x:Name="CopyBtn" Style="{StaticResource Btn.Icon}" ToolTip="{core:Loc Viewer.Copy}" Click="Copy_Click">
                        <ui:IconView Icon="copy"/>
                    </Button>
                    <Button x:Name="EditBtn" Style="{StaticResource Btn.Secondary}" ToolTip="{core:Loc Viewer.EditTip}" Click="Edit_Click" Margin="6,0,0,0" Padding="12,5">
                        <StackPanel Orientation="Horizontal">
                            <ui:IconView Icon="pen" Width="15" Height="15"/>
                            <TextBlock x:Name="EditText" Text="{core:Loc Viewer.Edit}" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <ui:CaptionButtons Grid.Column="3"/>
            </Grid>
        </Border>

        <!-- ================= The picture ================= -->
        <vw:ZoomImageView x:Name="View" Grid.Row="1"/>

        <StackPanel x:Name="MessageView" Grid.Row="1" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
            <ui:IconView Icon="image" Width="46" Height="46" StrokeWidth="1.4" Foreground="{DynamicResource Brush.TextTertiary}" HorizontalAlignment="Center"/>
            <TextBlock x:Name="MessageText" Style="{StaticResource Text.Secondary}" Margin="0,14,0,0" TextAlignment="Center" MaxWidth="420"/>
        </StackPanel>
    </Grid>
</Window>
