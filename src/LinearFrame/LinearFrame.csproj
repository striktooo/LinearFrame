<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <AssemblyName>LinearFrame</AssemblyName>
    <RootNamespace>LinearFrame</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Program.Main first hands a second start over to the running copy, before WPF is loaded -->
    <StartupObject>LinearFrame.Program</StartupObject>
    <ApplicationIcon Condition="Exists('Assets\LinearFrame.ico')">Assets\LinearFrame.ico</ApplicationIcon>

    <Version>1.3.0</Version>
    <Product>LinearFrame</Product>
    <Description>Screenshots, media player and quick lossless trimming for Windows.</Description>
    <Copyright>LinearFrame contributors</Copyright>
    <NeutralLanguage>en</NeutralLanguage>

    <!-- Keep the app small and frugal -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <DebugType>embedded</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CA1416;WPF0001</NoWarn>
  </PropertyGroup>

  <!-- Release publish: a small LinearFrame.exe + LinearFrame.dll that run on their own copy of .NET in the "runtime"
       folder next to them (build.ps1 puts it there; the exe looks nowhere else) - no .NET install needed on the target PC.
       Deliberately NOT one big self-contained exe (as up to 1.2.0): an antivirus reads such a 146 MB file from end to end
       (Microsoft Defender: about 4 s) the first time it is touched after every restart and after every update of its
       definitions - and it is touched all the time: WPF opens the exe for its icon whenever a window is created, and
       opening a file with LinearFrame starts the exe once more. The first screenshot or opened file after a restart
       waited for that. A 0.2 MB exe is read in no time, the libraries are read once when they load. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
    <AppHostRelativeDotNet>runtime</AppHostRelativeDotNet>
    <!-- The source file names kept with the debug information (they show in the stack traces of the log, and in the
         Source Link map to this repository) start at "/_/" = the repository - not at the folder the building machine
         happens to keep it in, which would put that machine's user name into every released LinearFrame.dll. -->
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF projects don't get System.IO implicitly (Path clashes with Shapes.Path) -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
    <RuntimeHostConfigurationOption Include="System.GC.RetainVM" Value="false" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\LinearFrame.ico" Condition="Exists('Assets\LinearFrame.ico')" />
    <!-- caption font of the video editor (TikTok Sans SemiBold, SIL Open Font License - see Assets\Fonts\OFL.txt) -->
    <Resource Include="Assets\Fonts\*.ttf" />
    <!-- Polish emoji names and keywords for the emoji search (Unicode CLDR, Unicode License v3) -->
    <Resource Include="Assets\emoji-pl.txt.gz" />
    <!-- one second of a dark, silent 320x180 picture (made with FFmpeg's "color" source): what the player plays out of
         sight right after the app has started, so the first real film finds everything loaded (App.Rehearsal.cs) -->
    <EmbeddedResource Include="Assets\rehearsal.mp4" LogicalName="LinearFrame.rehearsal.mp4" />
  </ItemGroup>

  <!-- Playback engine (libmpv) and ffmpeg live in an "engine" folder next to the exe -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\deps\mpv\libmpv-2.dll')">
    <None Include="$(MSBuildThisFileDirectory)..\..\deps\mpv\libmpv-2.dll" Link="engine\libmpv-2.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\deps\ffmpeg\ffmpeg.exe')">
    <None Include="$(MSBuildThisFileDirectory)..\..\deps\ffmpeg\ffmpeg.exe" Link="engine\ffmpeg.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
  <!-- Text recognition: ONNX Runtime (+ the Visual C++ runtime it needs) and the PP-OCRv5 models -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\..\deps\ocr\*.*" Link="engine\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

</Project>
