<Window x:Class="LinearFrame.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:LinearFrame.Core"
        xmlns:ui="clr-namespace:LinearFrame.UI"
        Title="LinearFrame" Width="1000" Height="660" MinWidth="800" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.ContentBg}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="{StaticResource Font.UI}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid TextElement.Foreground="{DynamicResource Brush.Text}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="228"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= Sidebar ================= -->
        <Border Background="{DynamicResource Brush.SidebarBg}" BorderBrush="{DynamicResource Brush.Separator}" BorderThickness="0,0,1,0">
            <DockPanel Margin="12,0,12,14">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,20,0,24">
                    <Image x:Name="AppIconImage" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="LinearFrame" FontFamily="{StaticResource Font.Display}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{core:Loc App.Tagline}" Style="{StaticResource Text.Caption}" FontSize="11" Margin="0,1,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="10,0,0,0">
                    <TextBlock x:Name="VersionText" Style="{StaticResource Text.Caption}"/>
                </StackPanel>

                <StackPanel>
                    <RadioButton x:Name="NavScreens" Style="{StaticResource Sidebar.Item}" GroupName="nav" Tag="screens" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <ui:IconView Icon="screenshot" Foreground="{DynamicResource Brush.Accent}"/>
                            <TextBlock Text="{core:Loc Nav.Screens}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavPlayer" Style="{StaticResource Sidebar.Item}" GroupName="nav" Tag="player" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <ui:IconView Icon="film" Foreground="{DynamicResource Brush.Accent}"/>
                            <TextBlock Text="{core:Loc Nav.Player}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavSettings" Style="{StaticResource Sidebar.Item}" GroupName="nav" Tag="settings" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <ui:IconView Icon="settings" Foreground="{DynamicResource Brush.Accent}"/>
                            <TextBlock Text="{core:Loc Nav.Settings}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ================= Content ================= -->
        <Grid Grid.Column="1">
            <ui:CaptionButtons Panel.ZIndex="10"/>

            <!-- ===== Screenshots ===== -->
            <Grid x:Name="ScreensPage" Margin="32,50,22,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="{core:Loc Screens.Title}" Style="{StaticResource Text.LargeTitle}"/>
                        <TextBlock x:Name="ScreensSubtitle" Style="{StaticResource Text.Secondary}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource Btn.Secondary}" Click="OpenFolder_Click" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <ui:IconView Icon="folder" Width="16" Height="16"/>
                                <TextBlock Text="{core:Loc Screens.OpenFolder}" Margin="7,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Btn.Primary}" Click="NewShot_Click">
                            <StackPanel Orientation="Horizontal">
                                <ui:IconView Icon="screenshot" Width="16" Height="16" Foreground="White"/>
                                <TextBlock Text="{core:Loc Screens.New}" Margin="7,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <Border x:Name="WelcomeBanner" Grid.Row="1" Background="{DynamicResource Brush.Banner}" BorderBrush="{DynamicResource Brush.BannerBorder}"
                        BorderThickness="1" CornerRadius="12" Padding="18,16" Margin="0,22,10,0" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Image x:Name="BannerIcon" Width="46" Height="46" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <StackPanel Grid.Column="1" Margin="14,0,18,0">
                            <TextBlock Text="{core:Loc Welcome.Title}" Style="{StaticResource Text.Title}"/>
                            <TextBlock x:Name="WelcomeBody" Style="{StaticResource Text.Secondary}" Margin="0,5,0,0" LineHeight="19"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <Button Style="{StaticResource Btn.Primary}" Content="{core:Loc Welcome.Try}" Click="NewShot_Click" Margin="0,0,0,7"/>
                            <Button Style="{StaticResource Btn.Secondary}" Content="{core:Loc Welcome.Dismiss}" Click="DismissWelcome_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <ScrollViewer x:Name="ShotsScroll" Grid.Row="2" Margin="0,22,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="ShotsList" Margin="0,0,0,24">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel x:Name="ShotsEmpty" Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed" Margin="0,0,0,40">
                    <ui:IconView Icon="image" Width="60" Height="60" StrokeWidth="1.3" Foreground="{DynamicResource Brush.TextTertiary}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{core:Loc Screens.Empty}" Style="{StaticResource Text.Title}" HorizontalAlignment="Center" Margin="0,14,0,6"/>
                    <TextBlock x:Name="ShotsEmptyHint" Style="{StaticResource Text.Secondary}" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="380"/>
                </StackPanel>
            </Grid>

            <!-- ===== Player ===== -->
            <Grid x:Name="PlayerPage" Margin="32,50,32,24" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="{core:Loc Player.Title}" Style="{StaticResource Text.LargeTitle}"/>
                    <TextBlock Text="{core:Loc Player.Subtitle}" Style="{StaticResource Text.Secondary}" Margin="0,4,0,0"/>
                </StackPanel>

                <Grid x:Name="DropZone" Grid.Row="1" Margin="0,22,0,0" Height="200" AllowDrop="True" Background="Transparent"
                      Drop="DropZone_Drop" DragEnter="DropZone_DragEnter" DragLeave="DropZone_DragLeave">
                    <Border x:Name="DropZoneFill" CornerRadius="14" Background="{DynamicResource Brush.CardBg}"/>
                    <Rectangle x:Name="DropZoneBorder" RadiusX="14" RadiusY="14" Stroke="{DynamicResource Brush.TextTertiary}" StrokeDashArray="4 3" StrokeThickness="1.4"/>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <ui:IconView Icon="film" Width="46" Height="46" StrokeWidth="1.4" Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{core:Loc Player.Drop}" Style="{StaticResource Text.Title}" Margin="0,12,0,14" HorizontalAlignment="Center"/>
                        <Button Style="{StaticResource Btn.Primary}" Content="{core:Loc Player.Open}" HorizontalAlignment="Center" Click="OpenMedia_Click"/>
                    </StackPanel>
                </Grid>

                <DockPanel Grid.Row="2" Margin="0,24,0,0">
                    <TextBlock x:Name="RecentHeader" DockPanel.Dock="Top" Text="{core:Loc Player.Recent}" Style="{StaticResource Text.Headline}" Margin="4,0,0,8"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="RecentList"/>
                    </ScrollViewer>
                </DockPanel>

                <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,16,0,0" Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{core:Loc Player.SetDefault}" FontWeight="Medium"/>
                            <TextBlock Text="{core:Loc Player.SetDefaultHint}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,2,12,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource Btn.Secondary}" Click="SetDefault_Click" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <ui:IconView Icon="link" Width="16" Height="16"/>
                                <TextBlock Text="{core:Loc Settings.Change}" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Grid>

            <!-- ===== Settings ===== -->
            <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="32,50,32,36" MaxWidth="700" HorizontalAlignment="Left" MinWidth="520">
                    <TextBlock Text="{core:Loc Settings.Title}" Style="{StaticResource Text.LargeTitle}" Margin="0,0,0,20"/>

                    <!-- Shortcuts -->
                    <TextBlock Text="{core:Loc Settings.Shortcuts}" Style="{StaticResource Text.Headline}" Margin="4,0,0,8"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Style="{StaticResource Card.Row}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:IconView Icon="screenshot" Width="17" Height="17" Foreground="{DynamicResource Brush.Accent}"/>
                                    <TextBlock Text="{core:Loc Settings.RegionHotkey}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <ui:HotkeyBox x:Name="RegionHotkeyBox" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <Border Style="{StaticResource Card.Separator}"/>
                            <Grid Style="{StaticResource Card.Row}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:IconView Icon="fullscreen" Width="17" Height="17" Foreground="{DynamicResource Brush.Accent}"/>
                                    <TextBlock Text="{core:Loc Settings.FullHotkey}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <ui:HotkeyBox x:Name="FullHotkeyBox" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{core:Loc Settings.HotkeyHint}" Style="{StaticResource Text.Caption}" Margin="4,7,0,24"/>

                    <!-- Saving -->
                    <TextBlock Text="{core:Loc Settings.Saving}" Style="{StaticResource Text.Headline}" Margin="4,0,0,8"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Style="{StaticResource Card.Row}">
                                <TextBlock Text="{core:Loc Settings.Clipboard}" VerticalAlignment="Center"/>
                                <CheckBox x:Name="ClipboardToggle" Style="{StaticResource Toggle.Switch}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Border Style="{StaticResource Card.Separator}"/>
                            <Grid Style="{StaticResource Card.Row}">
                                <TextBlock Text="{core:Loc Settings.AutoSave}" VerticalAlignment="Center"/>
                                <CheckBox x:Name="AutoSaveToggle" Style="{StaticResource Toggle.Switch}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Border Style="{StaticResource Card.Separator}"/>
                            <Grid Style="{StaticResource Card.Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{core:Loc Settings.Folder}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="FolderText" Grid.Column="1" Style="{StaticResource Text.Caption}" FontSize="12.5"
                                           VerticalAlignment="Center" HorizontalAlignment="Right" Margin="16,0,10,0" TextTrimming="CharacterEllipsis"/>
                                <Button Grid.Column="2" Style="{StaticResource Btn.Secondary}" Content="{core:Loc Settings.Change}" Click="ChangeFolder_Click" VerticalAlignment="Center" Padding="12,5"/>
                            </Grid>
                            <Border Style="{StaticResource Card.Separator}"/>
                            <Grid Style="{StaticResource Card.Row}">
                                <TextBlock Text="{core:Loc Settings.Format}" VerticalAlignment="Center"/>
                                <Border Style="{StaticResource Segment.Container}" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="FmtPng" Style="{StaticResource Segment.Item}" GroupName="fmt" Content="PNG"/>
                                        <RadioButton x:Name="FmtJpg" Style="{StaticResource Segment.Item}" GroupName="fmt" Content="JPG"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Border Style="{StaticResource Card.Separator}"/>
                            <Grid Style="{StaticResource Card.Row}">
                                <TextBlock Text="{core:Loc Settings.ExportSize}" VerticalAlignment="Center"/>
                                <Border Style="{StaticResource Segment.Container}" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <StackPanel x:Name="SizePanel" Orientation="Horizontal"/>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Behaviour -->
                    <TextBlock Text="{core:Loc Settings.Behaviour}" Style="{StaticResource Text.Headline}" Margin="4,24,0,8"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Style="{StaticResource Card.Row}">
                                <TextBlock Text="{core:Loc Settings.DetectWindows}" VerticalAlignment="Center"/>
                                <CheckBox x:Name="DetectToggle" Style="{StaticResource Toggle.Switch}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Border Style="{StaticResource Card.Separator}"/>
                            <Grid Style="{StaticResource Card.Row}">
                                <TextBlock Text="{core:Loc Settings.Thumbnail}" VerticalAlignment="Center"/>
                                <CheckBox x:Name="ThumbToggle" Style="{StaticResource Toggle.Switch}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Border Style="{StaticResource Card.Separator}"/>
                            <Grid Style="{StaticResource Card.Row}">
                                <TextBlock Text="{core:Loc Settings.Sound}" VerticalAlignment="Center"/>
                                <CheckBox x:Name="SoundToggle" Style="{StaticResource Toggle.Switch}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Border Style="{StaticResource Card.Separator}"/>
                            <Grid Style="{StaticResource Card.Row}">
                                <TextBlock Text="{core:Loc Settings.Startup}" VerticalAlignment="Center"/>
                                <CheckBox x:Name="StartupToggle" Style="{StaticResource Toggle.Switch}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Border Style="{StaticResource Card.Separator}"/>
                            <Grid Style="{StaticResource Card.Row}">
                                <TextBlock Text="{core:Loc Settings.Language}" VerticalAlignment="Center"/>
                                <Border Style="{StaticResource Segment.Container}" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="LangAuto" Style="{StaticResource Segment.Item}" GroupName="lang" Content="{core:Loc Settings.LangAuto}"/>
                                        <RadioButton x:Name="LangPl" Style="{StaticResource Segment.Item}" GroupName="lang" Content="Polski"/>
                                        <RadioButton x:Name="LangEn" Style="{StaticResource Segment.Item}" GroupName="lang" Content="English"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="LangHint" Text="{core:Loc Settings.LangRestart}" Style="{StaticResource Text.Caption}" Margin="4,7,0,0" Visibility="Collapsed"/>

                    <!-- Updates -->
                    <TextBlock Text="{core:Loc Settings.Updates}" Style="{StaticResource Text.Headline}" Margin="4,24,0,8"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Style="{StaticResource Card.Row}">
                                <TextBlock Text="{core:Loc Settings.AutoUpdate}" VerticalAlignment="Center"/>
                                <CheckBox x:Name="AutoUpdateToggle" Style="{StaticResource Toggle.Switch}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Border Style="{StaticResource Card.Separator}"/>
                            <Grid Style="{StaticResource Card.Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="UpdateStatusText" VerticalAlignment="Center" Style="{StaticResource Text.Secondary}" Margin="0,0,12,0"/>
                                <Button x:Name="UpdateButton" Grid.Column="1" Style="{StaticResource Btn.Secondary}" Content="{core:Loc Update.Check}"
                                        Click="Update_Click" VerticalAlignment="Center" Padding="12,5"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{core:Loc Settings.AutoUpdateHint}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="4,7,0,0"/>

                    <!-- About -->
                    <TextBlock Text="{core:Loc Settings.About}" Style="{StaticResource Text.Headline}" Margin="4,24,0,8"/>
                    <Border Style="{StaticResource Card}" Padding="16,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Image x:Name="AboutIcon" Width="44" Height="44" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="AboutVersion" FontWeight="SemiBold"/>
                                <TextBlock Text="{core:Loc Settings.OpenSource}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource Btn.Secondary}" Click="GitHub_Click" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <ui:IconView Icon="link" Width="16" Height="16"/>
                                    <TextBlock Text="{core:Loc Settings.GitHub}" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
