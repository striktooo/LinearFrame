<UserControl x:Class="LinearFrame.Player.Edit.VideoEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:LinearFrame.Core"
             xmlns:ui="clr-namespace:LinearFrame.UI"
             xmlns:pl="clr-namespace:LinearFrame.Player"
             xmlns:ed="clr-namespace:LinearFrame.Player.Edit"
             Foreground="White" FontSize="13" Focusable="False"
             FontFamily="{StaticResource Font.UI}">
    <UserControl.Resources>
        <Style x:Key="Tool" TargetType="Button" BasedOn="{StaticResource Hud.IconButton}">
            <Setter Property="Width" Value="Auto"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#26FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3DFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#A1A1A6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Border Background="#161618" BorderBrush="#2C2C2E" BorderThickness="0,1,0,0">
        <Grid Margin="10,6,10,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" MinHeight="42"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="42"/>
            </Grid.RowDefinitions>

            <!-- ============ tools ============ -->
            <Grid x:Name="ToolsRow">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource Hud.IconButton}" Width="40" Height="36" Click="Play_Click" ToolTip="{core:Loc Edit.PlayTip}">
                        <ui:IconView x:Name="PlayIcon" Icon="play" Width="20" Height="20"/>
                    </Button>
                    <TextBlock x:Name="TimeText" VerticalAlignment="Center" Margin="6,0,0,0" FontSize="12.5" Foreground="#E5E5EA" MinWidth="104"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button x:Name="SplitBtn" Style="{StaticResource Tool}" Click="Split_Click" ToolTip="{core:Loc Edit.SplitTip}">
                        <StackPanel Orientation="Horizontal"><ui:IconView Icon="scissors" Width="16" Height="16"/><TextBlock Text="{core:Loc Edit.Split}" Margin="6,0,0,0"/></StackPanel>
                    </Button>
                    <Button x:Name="DeleteBtn" Style="{StaticResource Tool}" Click="Delete_Click" ToolTip="{core:Loc Edit.DeleteTip}">
                        <StackPanel Orientation="Horizontal"><ui:IconView Icon="trash" Width="16" Height="16"/><TextBlock Text="{core:Loc Edit.Delete}" Margin="6,0,0,0"/></StackPanel>
                    </Button>
                    <Border x:Name="ToolsSep" Width="1" Margin="8,10" Background="#3A3A3C"/>
                    <Button x:Name="TextBtn" Style="{StaticResource Tool}" Click="Text_Click" ToolTip="{core:Loc Edit.TextTip}">
                        <StackPanel Orientation="Horizontal"><ui:IconView Icon="text" Width="16" Height="16"/><TextBlock Text="{core:Loc Edit.Text}" Margin="6,0,0,0"/></StackPanel>
                    </Button>
                    <Button x:Name="BannerBtn" Style="{StaticResource Tool}" Click="Banner_Click" MouseRightButtonUp="Banner_RightClick" ToolTip="{core:Loc Edit.BannerTip}">
                        <StackPanel Orientation="Horizontal"><ui:IconView Icon="banner" Width="16" Height="16"/><TextBlock Text="{core:Loc Edit.Banner}" Margin="6,0,0,0"/></StackPanel>
                    </Button>
                    <Button x:Name="FormatBtn" Style="{StaticResource Tool}" Click="Format_Click" ToolTip="{core:Loc Edit.FormatTip}">
                        <StackPanel Orientation="Horizontal"><ui:IconView Icon="aspect" Width="16" Height="16"/><TextBlock Text="{core:Loc Edit.Format}" Margin="6,0,0,0"/></StackPanel>
                    </Button>
                    <Button x:Name="ClipBtn" Style="{StaticResource Tool}" Click="AddClip_Click" ToolTip="{core:Loc Edit.AddClipTip}">
                        <StackPanel Orientation="Horizontal"><ui:IconView Icon="plus" Width="16" Height="16"/><TextBlock Text="{core:Loc Edit.AddClip}" Margin="6,0,0,0"/></StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="UndoBtn" Style="{StaticResource Hud.IconButton}" Click="Undo_Click" ToolTip="{core:Loc Edit.Undo}">
                        <ui:IconView Icon="undo" Width="17" Height="17"/>
                    </Button>
                    <Button x:Name="RedoBtn" Style="{StaticResource Hud.IconButton}" Click="Redo_Click" ToolTip="{core:Loc Edit.Redo}">
                        <ui:IconView Icon="redo" Width="17" Height="17"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ============ caption: the caption tool, the same one the picture editor has ============ -->
            <ed:CaptionPanel x:Name="Caption" Visibility="Collapsed"/>

            <!-- ============ emoji / banner ============ -->
            <Grid x:Name="ItemRow" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ItemTitle" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{core:Loc Edit.Size}" Style="{StaticResource Caption}" Margin="0,0,10,0"/>
                    <pl:ThinSlider x:Name="ItemSize" Width="160" VerticalAlignment="Center"/>
                    <Border x:Name="BannerPlace" Background="#2C2C2E" CornerRadius="8" Padding="2" Margin="16,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Hud.Button}" Background="Transparent" Content="{core:Loc Edit.BannerTop}" Click="Place_Click" Tag="0.22"/>
                            <Button Style="{StaticResource Hud.Button}" Background="Transparent" Content="{core:Loc Edit.BannerMiddle}" Click="Place_Click" Tag="0.5"/>
                            <Button Style="{StaticResource Hud.Button}" Background="Transparent" Content="{core:Loc Edit.BannerBottom}" Click="Place_Click" Tag="0.78"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource Hud.IconButton}" Click="ItemDelete_Click" ToolTip="{core:Loc Edit.DeleteTip}"><ui:IconView Icon="trash" Width="17" Height="17"/></Button>
                    <Button Style="{StaticResource Hud.Yellow}" Content="{core:Loc Edit.Done}" Click="Done_Click" Margin="6,0,0,0"/>
                </StackPanel>
            </Grid>

            <!-- ============ format: the frame's shape on top, how the video sits in it underneath ============ -->
            <Grid x:Name="FormatRow" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="38"/>
                </Grid.RowDefinitions>
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="1" Background="#2C2C2E" CornerRadius="8" Padding="2" VerticalAlignment="Center">
                        <StackPanel x:Name="FormatPanel" Orientation="Horizontal"/>
                    </Border>
                    <Button Grid.Column="2" Style="{StaticResource Hud.Yellow}" Content="{core:Loc Edit.Done}" Click="Done_Click" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Background="#2C2C2E" CornerRadius="8" Padding="2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Hud.Button}" Background="Transparent" Content="{core:Loc Edit.Fit}" Click="Fit_Click" Padding="10,4"/>
                            <Button Style="{StaticResource Hud.Button}" Background="Transparent" Content="{core:Loc Edit.Fill}" Click="Fill_Click" Padding="10,4"/>
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center" ToolTip="{core:Loc Edit.Zoom}">
                        <ui:IconView Icon="minus" Width="13" Height="13" Foreground="#A1A1A6" Margin="0,0,6,0"/>
                        <pl:ThinSlider x:Name="ZoomSlider" Width="96" VerticalAlignment="Center"/>
                        <ui:IconView Icon="plus" Width="13" Height="13" Foreground="#A1A1A6" Margin="6,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="{core:Loc Edit.Background}" Style="{StaticResource Caption}" Margin="16,0,8,0"/>
                    <Border Background="#2C2C2E" CornerRadius="8" Padding="2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="BgBlur" Style="{StaticResource HudSegment.Item}" GroupName="bg" Content="{core:Loc Edit.BgBlur}" Checked="Bg_Checked"/>
                            <RadioButton x:Name="BgBlack" Style="{StaticResource HudSegment.Item}" GroupName="bg" Content="{core:Loc Edit.BgBlack}" Checked="Bg_Checked"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#2C2C2E" CornerRadius="8" Padding="2" Margin="16,0,0,0" VerticalAlignment="Center" ToolTip="{core:Loc Edit.Quality}">
                        <StackPanel x:Name="QualityPanel" Orientation="Horizontal"/>
                    </Border>
                </StackPanel>
            </Grid>

            <ed:EditTimeline x:Name="Timeline" Grid.Row="1" Margin="0,4,0,2"/>

            <!-- ============ cancel / save ============ -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource Hud.Button}" Background="#2C2C2E" Content="{core:Loc Player.Cancel}" Click="Cancel_Click" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                    <TextBlock x:Name="InfoText" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                        <ui:IconView x:Name="InfoIcon" Icon="check" Width="12" Height="12" Foreground="#30D158" StrokeWidth="2.6" Margin="0,0,4,0"/>
                        <TextBlock x:Name="InfoNote" FontSize="11.5" Foreground="#A1A1A6"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel x:Name="SaveButtons" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource Hud.Button}" Background="#2C2C2E" Content="{core:Loc Player.SaveNew}" Click="SaveNew_Click" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource Hud.Yellow}" Content="{core:Loc Player.Replace}" Click="Replace_Click"/>
                </StackPanel>
                <StackPanel x:Name="SaveProgress" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="{core:Loc Player.Saving}" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#E5E5EA"/>
                    <Grid Width="150" Height="5" VerticalAlignment="Center">
                        <Border CornerRadius="2.5" Background="#3A3A3C"/>
                        <Border x:Name="SaveFill" CornerRadius="2.5" Background="#FFD60A" HorizontalAlignment="Left" Width="0"/>
                    </Grid>
                </StackPanel>
            </Grid>

        </Grid>
    </Border>
</UserControl>
