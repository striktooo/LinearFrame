<UserControl x:Class="LinearFrame.Player.Edit.CaptionPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:LinearFrame.Core"
             xmlns:ui="clr-namespace:LinearFrame.UI"
             xmlns:pl="clr-namespace:LinearFrame.Player"
             xmlns:ed="clr-namespace:LinearFrame.Player.Edit"
             Foreground="White" FontSize="13" Focusable="False"
             FontFamily="{StaticResource Font.UI}">
    <UserControl.Resources>
        <!-- the padding only once: the text box hands its Padding to the scroll viewer inside by itself - a Margin of the
             same padding on top of that took it twice and left the 40 px row 14 px for an 18 px line, cutting the
             letters' bottoms off -->
        <Style x:Key="DarkBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="SelectionBrush" Value="#0A84FF"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="#2C2C2E" CornerRadius="8" BorderBrush="#48484A" BorderThickness="1">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- the text on top, how it looks underneath -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="38"/>
        </Grid.RowDefinitions>
        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TextEdit" Style="{StaticResource DarkBox}" VerticalAlignment="Center"
                     AcceptsReturn="False" TextChanged="TextEdit_TextChanged" PreviewKeyDown="TextEdit_PreviewKeyDown"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                <Button x:Name="EmojiBtn" Style="{StaticResource Hud.IconButton}" Click="Emoji_Click" ToolTip="{core:Loc Edit.EmojiTip}">
                    <ui:IconView Icon="smile" Width="19" Height="19"/>
                </Button>
                <Button Style="{StaticResource Hud.IconButton}" Click="Delete_Click" ToolTip="{core:Loc Edit.DeleteTip}"><ui:IconView Icon="trash" Width="17" Height="17"/></Button>
                <Button Style="{StaticResource Hud.Yellow}" Content="{core:Loc Edit.Done}" Click="Done_Click" Margin="6,0,0,0"/>
            </StackPanel>
        </Grid>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border Background="#2C2C2E" CornerRadius="8" Padding="2" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="StyleStroke" Style="{StaticResource HudSegment.Item}" GroupName="capstyle" Content="{core:Loc Edit.StyleStroke}" Checked="Style_Checked" Tag="Stroke"/>
                    <RadioButton x:Name="StyleFill" Style="{StaticResource HudSegment.Item}" GroupName="capstyle" Content="{core:Loc Edit.StyleFill}" Checked="Style_Checked" Tag="Fill"/>
                    <RadioButton x:Name="StyleNone" Style="{StaticResource HudSegment.Item}" GroupName="capstyle" Content="{core:Loc Edit.StyleNone}" Checked="Style_Checked" Tag="None"/>
                </StackPanel>
            </Border>
            <StackPanel x:Name="Swatches" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center" ToolTip="{core:Loc Edit.Size}">
                <TextBlock Text="A" FontSize="11" Foreground="#A1A1A6" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <pl:ThinSlider x:Name="TextSize" Width="110" VerticalAlignment="Center"/>
                <TextBlock Text="A" FontSize="17" Foreground="#A1A1A6" VerticalAlignment="Center" Margin="6,0,0,0"/>
            </StackPanel>
        </StackPanel>

        <Popup x:Name="EmojiPopup" PlacementTarget="{Binding ElementName=EmojiBtn}" Placement="Top" StaysOpen="False"
               AllowsTransparency="True" PopupAnimation="Fade" VerticalOffset="-8" HorizontalOffset="-330">
            <ed:EmojiPicker x:Name="Picker" Margin="12"/>
        </Popup>
    </Grid>
</UserControl>
