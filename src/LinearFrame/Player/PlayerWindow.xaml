<Window x:Class="LinearFrame.Player.PlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:LinearFrame.Core"
        xmlns:ui="clr-namespace:LinearFrame.UI"
        xmlns:pl="clr-namespace:LinearFrame.Player"
        xmlns:ed="clr-namespace:LinearFrame.Player.Edit"
        Title="LinearFrame" Width="960" Height="560" MinWidth="420" MinHeight="250"
        WindowStartupLocation="CenterScreen" Background="Black" Foreground="White"
        FontFamily="{StaticResource Font.UI}" FontSize="13" UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid x:Name="VideoArea" Background="Black">
            <!-- editor: the finished video's frame - black or the blurred picture around the video (mpv draws only the video) -->
            <Canvas x:Name="Backdrop" Visibility="Collapsed" IsHitTestVisible="False">
                <Border x:Name="BackdropFrame" Background="Black" ClipToBounds="True">
                    <Grid>
                        <Image x:Name="BackdropImage" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="Linear">
                            <Image.Effect>
                                <BlurEffect x:Name="BackdropBlur" Radius="30" KernelType="Gaussian" RenderingBias="Performance"/>
                            </Image.Effect>
                        </Image>
                        <Border x:Name="BackdropDim" Background="#14000000"/>
                    </Grid>
                </Border>
            </Canvas>

            <!-- audio-only view: cover, title and the whole song as a waveform - everything scales with the window -->
            <Grid x:Name="AudioView" Visibility="Collapsed">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#2B2550" Offset="0"/>
                        <GradientStop Color="#141418" Offset="1"/>
                    </LinearGradientBrush>
                </Grid.Background>
                <Grid.RowDefinitions>
                    <RowDefinition Height="42"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="112"/>
                </Grid.RowDefinitions>
                <StackPanel x:Name="AudioStack" Grid.Row="1" VerticalAlignment="Center" Margin="32,0">
                    <Border x:Name="ArtBorder" Width="160" Height="160" CornerRadius="14" HorizontalAlignment="Center">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#7B61FF" Offset="0"/>
                                <GradientStop Color="#1FB6FF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.5" Direction="270"/>
                        </Border.Effect>
                        <Grid>
                            <ui:IconView x:Name="ArtIcon" Icon="music" Width="64" Height="64" StrokeWidth="1.4" Foreground="White"/>
                            <Border x:Name="ArtImageHost" CornerRadius="14" ClipToBounds="True" Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    <StackPanel x:Name="AudioTexts" Margin="0,18,0,0">
                        <TextBlock x:Name="AudioTitle" FontFamily="{StaticResource Font.Display}" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,2" Foreground="White"
                                   HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="AudioArtist" FontSize="13.5" Foreground="#A1A1A6" HorizontalAlignment="Center" TextAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <pl:WaveformView x:Name="Wave" Height="120" Margin="0,22,0,0" MaxWidth="1100"/>
                </StackPanel>
            </Grid>

            <!-- error / message -->
            <StackPanel x:Name="MessageView" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                <ui:IconView Icon="info" Width="44" Height="44" StrokeWidth="1.5" Foreground="#A1A1A6" HorizontalAlignment="Center"/>
                <TextBlock x:Name="MessageText" Foreground="#E5E5EA" FontSize="14" Margin="0,12,0,0" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420"/>
            </StackPanel>
        </Grid>

        <!-- ===== video editor (cuts, joins, captions, emoji, banner, format) ===== -->
        <ed:VideoEditor x:Name="Editor" Grid.Row="1" Visibility="Collapsed"/>
    </Grid>
</Window>
